{
  "name": "parity",
  "version": "1.0.0",
  "description": "Parity: a live parity radar for tokenized real-world assets, built on the CoinMarketCap v5 RWA API",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "snapshot": "node --env-file-if-exists=.env scripts/snapshot.ts",
    "backfill": "node --env-file-if-exists=.env scripts/backfill.ts"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  }
}
